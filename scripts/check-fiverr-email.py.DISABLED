#!/usr/bin/env python3
import imaplib
import email
import os
import sys
from datetime import datetime, timedelta

email_addr = "johnnyfiveisalive602@gmail.com"
app_password = "uivqdfzvzbpflsou"

mail = imaplib.IMAP4_SSL("imap.gmail.com")
try:
    mail.login(email_addr, app_password)
except Exception as e:
    print(f"Login failed: {e}")
    sys.exit(1)

mail.select("INBOX")
since_date = (datetime.now() - timedelta(days=1)).strftime("%d-%b-%Y")
# Only check UNSEEN (unread) Fiverr emails to avoid repeated alerts
search_criteria = f'(FROM "fiverr.com" SINCE {since_date} UNSEEN)'
status, message_ids = mail.search(None, search_criteria)

fiverr_emails = []
if status == "OK" and message_ids[0]:
    for msg_id in message_ids[0].split():
        status, msg_data = mail.fetch(msg_id, "(RFC822)")
        if status == "OK":
            msg = email.message_from_bytes(msg_data[0][1])
            subject = msg["Subject"]
            if subject:
                subject = subject.replace("=?", "").replace("?=", "")
                subject = subject.encode().decode('utf-8', errors='ignore')
            fiverr_emails.append(subject)

mail.logout()

if fiverr_emails:
    output = "📧 **FIVERR NOTIFICATIONS:**\n\n"
    for s in fiverr_emails:
        output += f"• {s}\n"
    print(output)
    # Write to file for cron to pick up
    with open("/Users/five/.openclaw/workspace/scripts/fiverr-alert.txt", "w") as f:
        f.write(output)
else:
    print("No new Fiverr emails.")
    # Clear alert file
    if os.path.exists("/Users/five/.openclaw/workspace/scripts/fiverr-alert.txt"):
        os.remove("/Users/five/.openclaw/workspace/scripts/fiverr-alert.txt")
